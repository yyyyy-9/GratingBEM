include README.md CHANGELOG.md LICENSE pyproject.toml main.py
recursive-include src/gratingbem *.py
recursive-include docs/zh *.md
recursive-include examples *.py *.json
prune .local
prune .github
prune tests
prune benchmarks
prune build
prune dist
prune .pytest_cache
prune __pycache__
global-exclude *.py[cod]
